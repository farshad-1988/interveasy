# ==============================================================================
# Interveasy API — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
#   cp .env.example .env
#
# NEVER commit your real .env file to version control.
# This .env.example file IS safe to commit — it contains no real secrets.
# ==============================================================================


# ------------------------------------------------------------------------------
# Database connection (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
# Example for a local Docker Postgres container:
#   docker run --name nest_postgres -e POSTGRES_PASSWORD=yourpassword -p 5432:5432 -d postgres
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/interveasy?schema=public"


# ------------------------------------------------------------------------------
# JWT Configuration
# ------------------------------------------------------------------------------
# IMPORTANT: Use a long, random, unpredictable string in production.
# Minimum 32 characters. You can generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-very-long-random-secret-key-here-at-least-32-chars

# How long an access token is valid before the client must refresh it.
# Supported formats: 15m | 1h | 12h | 1d  (m=minutes, h=hours, d=days)
JWT_ACCESS_EXPIRES_IN=15m

# How long a refresh token is valid. After this period the user must log in again.
JWT_REFRESH_EXPIRES_IN=7d


# ------------------------------------------------------------------------------
# Cookie settings
# ------------------------------------------------------------------------------
# COOKIE_SECURE: set to true in production so cookies are only sent over HTTPS.
# Leave false for local HTTP development.
COOKIE_SECURE=false

# COOKIE_SAMESITE controls cross-site cookie behaviour.
#   lax    — cookies sent on top-level navigations (safe default)
#   strict — cookies never sent cross-site (maximum protection)
#   none   — cookies always sent cross-site (requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax


# ------------------------------------------------------------------------------
# CORS — Cross-Origin Resource Sharing
# ------------------------------------------------------------------------------
# The origin(s) allowed to call this API.
# For multiple origins separate with a comma, e.g.:
#   CORS_ORIGIN=http://localhost:3000,https://app.example.com
CORS_ORIGIN=http://localhost:3000
